{
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@stylistic/eslint-plugin": "^5.6.1",
		"@types/node": "^25.0.3",
		"@typescript/native-preview": "^7.0.0-dev.20251230.1",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.2",
		"highlight.js": "^11.11.1",
		"jiti": "^2.6.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.51.0"
	},
	"name": "fileserver",
	"scripts": {
		"build:api": "npm run build -w @fileserver/api",
		"build:web": "npm run build -w @fileserver/web",
		"build": "npm run build:api && npm run build:web",
		"dev:api": "npm run dev -w @fileserver/api",
		"dev:web": "npm run dev -w @fileserver/web",
		"dev": "concurrently -n 'API,WEB' -c 'bgBlue.black,bgMagentaBright.black' 'npm run dev:api' 'npm run dev:web'",
		"lint": "eslint apps"
	},
	"version": "0.0.1",
	"workspaces": [
		"apps/*"
	]
}
